generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(uuid())
  email               String           @unique
  passwordHash        String
  name                String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  experienceLevel     String?
  lossGuardrail       Decimal?         @db.Decimal(18, 4)
  onboardingCompleted Boolean          @default(false)
  primaryMarket       String?
  profitGuardrail     Decimal?         @db.Decimal(18, 4)
  capitalEvents       CapitalEvent[]
  guardrailEvents     GuardrailEvent[]
  capitalCycles       CapitalCycle[]
  journals            Journal[]
  strategies          Strategy[]
  trades              Trade[]
}

model Trade {
  id              String          @id @default(uuid())
  userId          String
  symbol          String
  entryPrice      Decimal         @db.Decimal(18, 4)
  exitPrice       Decimal         @db.Decimal(18, 4)
  quantity        Decimal         @db.Decimal(18, 4)
  stopLoss        Decimal         @db.Decimal(18, 4)
  target          Decimal         @db.Decimal(18, 4)
  strategyId      String?
  emotion         String?
  marketCondition String?
  setupStrategy   String          @map("tradeSetup")
  entryTime       DateTime        @default(now()) @map("tradeDate")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lesson          String?
  planFollowed    Boolean?
  tradeNote       String          @map("quickNote")
  whatWentWell    String?
  whatWentWrong   String?
  journalId       String          @map("journalEntryId")
  stopLossSource  String?
  targetSource    String?
  tradeStyle      String?
  exitReason      TradeExitReason @default(MANUAL)
  exitTime        DateTime        @default(now())
  source          TradeSource     @default(MANUAL)
  tradeType       TradeTypeEnum   @default(INTRADAY) @map("tradeTypeNew")
  direction       TradeDirection  @map("tradeType")
  screenshots     Screenshot[]
  journal         Journal         @relation(fields: [journalId], references: [id], onDelete: Cascade)
  strategy        Strategy?       @relation(fields: [strategyId], references: [id])
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entryTime])
  @@index([symbol])
  @@index([strategyId])
  @@index([userId, entryTime])
}

model Strategy {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades      Trade[]

  @@index([userId])
}

model Journal {
  id                     String            @id @default(uuid())
  userId                 String
  date                   DateTime          @default(now()) @map("entryDate")
  marketThoughts         String?
  whatWentWrong          String?
  mistakes               String?
  lessons                String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  biggestMistake         String?
  emotionalTrade         EmotionalTrade?
  emotionalTradeOther    String?           @db.VarChar(100)
  executionQuality       ExecutionQuality?
  followedRiskManagement RiskManagement?
  followedTradingPlan    FollowedPlan?
  status                 JournalStatus     @default(DRAFT)
  tomorrowLesson         String?
  whatDidWell            String?
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades                 Trade[]

  @@unique([userId, date])
  @@map("JournalEntry")
}

model Screenshot {
  id               String   @id @default(uuid())
  tradeId          String
  storageKey       String
  originalFilename String
  mimeType         String
  fileSize         Int
  createdAt        DateTime @default(now())
  trade            Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model CapitalEvent {
  id        String           @id @default(uuid())
  userId    String
  type      CapitalEventType
  amount    Decimal          @db.Decimal(18, 4)
  eventDate DateTime         @default(now())
  note      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventDate])
}

model GuardrailEvent {
  id             String        @id @default(uuid())
  userId         String
  eventDate      DateTime      @default(now())
  triggerBalance Decimal       @db.Decimal(18, 4)
  reason         String?
  guardrailType  GuardrailType
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventDate])
}

enum TradeDirection {
  BUY
  SELL
}

enum TradeTypeEnum {
  INTRADAY
  DELIVERY
  SWING
}

enum TradeExitReason {
  TARGET
  STOP_LOSS
  MANUAL
}

enum TradeSource {
  MANUAL
  SCREENSHOT
}

enum JournalStatus {
  DRAFT
  COMPLETED
}

enum ExecutionQuality {
  EXCELLENT
  GOOD
  AVERAGE
  POOR
}

enum EmotionalTrade {
  NO
  FOMO
  REVENGE
  OVERTRADING
  FEAR
  GREED
  OTHER
}

enum FollowedPlan {
  YES
  PARTIALLY
  NO
}

enum RiskManagement {
  YES
  NO
}

enum CapitalEventType {
  STARTING_CAPITAL
  DEPOSIT
  WITHDRAWAL
  CAPITAL_RESET
  ADJUSTMENT
}

enum GuardrailType {
  PROFIT
  LOSS
}

model CapitalCycle {
  id              String    @id @default(uuid())
  userId          String
  baseCapital     Decimal   @db.Decimal(18, 4)
  profitGuardrail Decimal   @db.Decimal(18, 4)
  lossGuardrail   Decimal   @db.Decimal(18, 4)
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  status          String    @default("ACTIVE")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startedAt])
}
